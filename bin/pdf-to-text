#!/bin/bash
# Convert a PDF to text using only what macOS already has.
#
# The pipeline has always used `pdftotext`, which means `brew install poppler`, which
# means most teachers stop there. macOS ships PDFKit, reachable from JavaScript for
# Automation, so a specification PDF can be converted with nothing installed.
#
# Limitation: this gives reading order, not x/y positions. The specification is
# parsed line by line, so that is fine. Mark schemes are parsed by column position,
# so they still need pdftotext.
#
# Usage:  bin/pdf-to-text input.pdf > specification.txt

set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: bin/pdf-to-text <file.pdf> > out.txt" >&2
  exit 2
fi

PDF="$1"

if [ ! -f "$PDF" ]; then
  echo "No such file: $PDF" >&2
  exit 2
fi

# Prefer pdftotext when it exists: it keeps layout, which is better for everything.
if command -v pdftotext >/dev/null 2>&1; then
  exec pdftotext -layout -enc UTF-8 "$PDF" -
fi

ABS="$(cd "$(dirname "$PDF")" && pwd)/$(basename "$PDF")"

/usr/bin/osascript -l JavaScript -e "
ObjC.import('Quartz');
const url = \$.NSURL.fileURLWithPath('${ABS}');
const doc = \$.PDFDocument.alloc.initWithURL(url);
if (!doc) throw new Error('Could not open the PDF');
ObjC.unwrap(doc.string);
" || {
  echo "Could not read $PDF. If it is a scan rather than text, it needs OCR first." >&2
  exit 1
}
